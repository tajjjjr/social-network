{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "test": "vitest run",
    "build": "next build",
    "start": "next start",
    "serve:next": "dotenv -e .env -- sh -c 'PORT=$NEXT_PORT next dev'",
    "serve:go": "dotenv -e .env -- sh -c 'cd ../backend && go run .'",
    "dev": "concurrently -k -n go,next -c yellow,cyan \"npm run serve:go\" \"npm run serve:next\""
  },
  "dependencies": {
    "autoprefixer": "^10.4.21",
    "emoji-picker-react": "^4.13.2",
    "lightningcss": "^1.30.1",
    "lucide-react": "^0.525.0",
    "next": "^15.5.2",
    "postcss": "^8.5.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-icons": "^5.5.0",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@testing-library/react": "^16.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.2.0",
    "dotenv-cli": "^8.0.0",
    "eslint": "^9",
    "eslint-config-next": "15.3.4",
    "jsdom": "^25.0.1",
    "tailwindcss": "^3.4.17",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "glob": "^11.0.0",
    "inflight": "npm:@isaacs/inflight@^1.0.6"
  },
  "engines": {
    "node": "^18.18.0 || ^20.9.0 || >=21.1.0"
  }
}
